{
  "name": "taxua-land",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @land/web dev",
    "build": "pnpm --filter @land/web build && node infra/check-client-syntax.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json && pnpm --filter @land/web typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:scan",
    "security:scan": "node infra/scan-secrets.mjs",
    "format": "prettier --write .",
    "db:migrate": "node --env-file=.env.local infra/migrate.ts",
    "test:e2e": "playwright test",
    "test:e2e:core": "node tests/support/core-runner.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.6.0",
    "terser-webpack-plugin": "5.3.14",
    "tsx": "4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "dependencies": {
    "exceljs": "4.4.0",
    "pg": "8.16.0",
    "yauzl": "3.4.0",
    "zod": "4.1.0"
  }
}
