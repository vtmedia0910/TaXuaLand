# LAND-only credentials. Never use another product's database or service role.
LAND_ENVIRONMENT=LOCAL
DATABASE_URL=postgresql://land_app:REPLACE_ME@127.0.0.1:55432/land
SERVER_ORIGIN=http://127.0.0.1:3000
# Absolute monorepo root for the isolated XLSX parser and private import volume.
LAND_WORKSPACE_ROOT=
# Optional integration-test maintenance connection; never expose to app runtime.
# Set only in the repo-root test/operator environment, using a separate owner role.
DATABASE_TEST_URL=
# Terrain/roads URLs come from approved database releases, not workbook/env input.
# No Cesium ion key is required. Production object-store credentials stay server-side.

# Phase 0.5 contract: LOCAL / PREVIEW / STAGING / PRODUCTION.
# PREVIEW: explicitly enable, set exact SERVER_ORIGIN=https://<VERCEL_URL>,
# and OMIT DATABASE_URL and all object-store credentials. VERCEL_ENV=preview
# and VERCEL_URL are supplied by Vercel. Never share staging write credentials.
LAND_PREVIEW_ENABLED=false
OBJECT_STORE_DRIVER=local
SIGNED_UPLOAD_TTL_SECONDS=300
IMPORT_RETENTION_DAYS=7
# STAGING/PRODUCTION require driver=s3 and distinct private/published buckets.
# The following names are server-only; inject values through a secret manager.
# OBJECT_STORE_ENDPOINT=https://<s3-compatible-host>
# OBJECT_STORE_REGION=<region>
# OBJECT_STORE_ACCESS_KEY_ID=<private-application-key>
# OBJECT_STORE_SECRET_ACCESS_KEY=<private-application-secret>
# PRIVATE_BUCKET=taxualand-private
# PUBLISHED_BUCKET=taxualand-published
# PUBLIC_ASSET_BASE_URL=https://<approved-asset-host>
# This milestone defines the contract; S3 runtime wiring follows in C/D/G.
